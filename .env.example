APP_URL=http://localhost:8110
ALLOWED_ORIGINS=
APP_PORT=8110
APP_IMAGE=ghcr.io/phillipunzen/project-planning-tool:feature-card-progress
PORT=8111

# External MariaDB: configure an existing database and account.
# localhost/127.0.0.1 would refer to the app container itself.
# Use host.docker.internal when MariaDB runs on the Docker host.
DATABASE_HOST=db.example.internal
DATABASE_PORT=3306
DATABASE_NAME=projektwerk
DATABASE_USER=projektwerk
DATABASE_PASSWORD=REPLACE_WITH_EXISTING_DATABASE_PASSWORD

SESSION_SECRET=GENERATE_WITH_INIT_SCRIPT
TRUST_PROXY=0

# Only needed with docker-compose.local.yml:
DATABASE_ROOT_PASSWORD=GENERATE_WITH_INIT_SCRIPT
# COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
